new file mode 100644
index 0000000000..456c15b78a
--- /dev/null
+++ b/tests/QS/regtest-rcp/check_relativistic_spinor_staging.py
@@ -0,0 +1,46 @@
+#!/usr/bin/env python3
+"""Check staged RCP spinor work without claiming full SOC/GAPW support."""
+
+from pathlib import Path
+import argparse
+
+
+def diagnostic(text: str, label: str) -> float:
+    """Read one floating-point RCP diagnostic from CP2K output."""
+    for line in text.splitlines():
+        if line.startswith(" RCP|") and label in line:
+            return float(line.split()[-1])
+    raise ValueError("No RCP diagnostic: " + label)
+
+
+def check(workdir: Path) -> None:
+    """Verify GPW regressions and explicit unsupported GAPW diagnostics."""
+    for method in ("zora", "dkh"):
+        path = workdir / "output" / method / f"h2o_{method}_guard.out"
+        log = path.read_text(errors="replace")
+        assert "SCF run converged in" in log, path
+        assert "[ABORT]" in log, path
+        assert "RCP for GAPW (including ZORA/DKH) requires one-center density" in log, path
+        assert "CPASSERT failed" not in log, path
+        print("PASS: explicit unsupported GAPW guard for", method)
+
+    expected = {
+        "gamma": (2.0, -1.134090736496),
+        "kpoints": (2.0, -1.134217737421),
+    }
+    for kind, (electrons, regional) in expected.items():
+        path = workdir / f"regression_{kind}" / f"h2_{kind}.out"
+        log = path.read_text(errors="replace")
+        assert "PROGRAM ENDED AT" in log and "[ABORT]" not in log, path
+        val = diagnostic(log, "Electron count from grid integration")
+        assert abs(val - electrons) < 1e-6, (path, val)
+        energy = diagnostic(log, "Regional energy density integral")
+        assert abs(energy - regional) < 1e-6, (path, energy)
+        print(f"PASS: existing {kind} RCP: Q={val:.9f}, regional={energy:.9f} Ha")
+
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument("directory", type=Path)
+    args = p.parse_args()
+    check(args.directory)
diff --git a/tests/QS/regtest-rcp/test_spinor_kernel.f90 b/tests/QS/regtest-rcp/test_spinor_kernel.f90
new file mode 100644
index 0000000000..5b7dd6dfb4
--- /dev/null
+++ b/tests/QS/regtest-rcp/test_spinor_kernel.f90
@@ -0,0 +1,84 @@
+! Test the spinor RCP kernel without requiring a CP2K calculation.
+PROGRAM test_rcp_spinor
+   USE, INTRINSIC :: iso_fortran_env, ONLY: real64
+   USE rcp_spinor, ONLY: rcp_spinor_local
+   IMPLICIT NONE
+   INTEGER, PARAMETER :: dp = real64
+   REAL(dp), PARAMETER :: tol = 1.0e-12_dp, k = 2.0_dp
+   COMPLEX(dp), PARAMETER :: iu = (0.0_dp, 1.0_dp)
+   COMPLEX(dp) :: psi(2, 2), grad(2, 3, 2), lap(2, 2)
+   REAL(dp) :: weights(2), n, m(3), tl, tg, er
+   REAL(dp) :: phi, cphase
+
+   psi = (0.0_dp, 0.0_dp)
+   grad = (0.0_dp, 0.0_dp)
+   lap = (0.0_dp, 0.0_dp)
+   weights = [0.6_dp, 0.4_dp]
+   psi(1, 1) = (1.0_dp, 0.0_dp)
+   psi(2, 2) = (1.0_dp, 0.0_dp)
+   grad(:, 1, :) = iu*k*psi(:, :)
+   lap = -(k*k)*psi
+
+   CALL rcp_spinor_local(psi, grad, lap, weights, n, m, tl, tg, er)
+   CALL near(n, 1.0_dp, "Collinear charge")
+   CALL near(m(1), 0.0_dp, "Collinear mx")
+   CALL near(m(2), 0.0_dp, "Collinear my")
+   CALL near(m(3), 0.2_dp, "Collinear mz")
+   CALL near(tl, 2.0_dp, "Laplacian kinetic")
+   CALL near(tg, 2.0_dp, "Gradient kinetic")
+   CALL near(er, -2.0_dp, "Regional energy")
+
+   ! Rotate the occupied spinor into the +y direction; charge/kinetic invariant.
+   psi = (0.0_dp, 0.0_dp)
+   psi(1, 1) = CMPLX(1.0_dp/SQRT(2.0_dp), 0.0_dp, KIND=dp)
+   psi(2, 1) = iu/SQRT(2.0_dp)
+   weights = [0.6_dp, 0.0_dp]
+   grad = (0.0_dp, 0.0_dp)
+   grad(:, 1, :) = iu*k*psi(:, :)
+   lap = -(k*k)*psi
+   CALL rcp_spinor_local(psi, grad, lap, weights, n, m, tl, tg, er)
+   CALL near(n, 0.6_dp, "Spinor charge")
+   CALL near(m(1), 0.0_dp, "Spinor mx")
+   CALL near(m(2), 0.6_dp, "Spinor my")
+   CALL near(m(3), 0.0_dp, "Spinor mz")
+   CALL near(tl, 1.2_dp, "Spinor kinetic")
+   CALL near(tg, 1.2_dp, "Spinor gradient kinetic")
+   CALL near(er, -1.2_dp, "Spinor regional energy")
+
+   ! Global U(1) wavefunction phase must not change the observables.
+   phi = 0.678_dp
+   cphase = COS(phi)
+   psi = psi*CMPLX(cphase, SIN(phi), KIND=dp)
+   grad = grad*CMPLX(cphase, SIN(phi), KIND=dp)
+   lap = lap*CMPLX(cphase, SIN(phi), KIND=dp)
+   CALL rcp_spinor_local(psi, grad, lap, weights, n, m, tl, tg, er)
+   CALL near(n, 0.6_dp, "Phase-invariant charge")
+   CALL near(m(2), 0.6_dp, "Phase-invariant my")
+   CALL near(tl, 1.2_dp, "Phase-invariant kinetic")
+   CALL near(er, -1.2_dp, "Phase-invariant regional energy")
+   ! A global SU(2) rotation around z by -pi/2 maps +y polarization to +x.
+   phi = 0.25_dp*ACOS(-1.0_dp)
+   psi(1, :) = psi(1, :)*CMPLX(COS(phi), SIN(phi), KIND=dp)
+   psi(2, :) = psi(2, :)*CMPLX(COS(phi), -SIN(phi), KIND=dp)
+   grad(1, :, :) = grad(1, :, :)*CMPLX(COS(phi), SIN(phi), KIND=dp)
+   grad(2, :, :) = grad(2, :, :)*CMPLX(COS(phi), -SIN(phi), KIND=dp)
+   lap(1, :) = lap(1, :)*CMPLX(COS(phi), SIN(phi), KIND=dp)
+   lap(2, :) = lap(2, :)*CMPLX(COS(phi), -SIN(phi), KIND=dp)
+   CALL rcp_spinor_local(psi, grad, lap, weights, n, m, tl, tg, er)
+   CALL near(n, 0.6_dp, "SU(2) charge")
+   CALL near(m(1), 0.6_dp, "SU(2) mx")
+   CALL near(m(2), 0.0_dp, "SU(2) my")
+   CALL near(m(3), 0.0_dp, "SU(2) mz")
+   CALL near(tl, 1.2_dp, "SU(2) kinetic")
+   CALL near(er, -1.2_dp, "SU(2) regional energy")
+   PRINT '(A)', "PASS: collinear, noncollinear, U(1), SU(2) and kinetic-energy tests"
+CONTAINS
+   SUBROUTINE near(actual, expected, label)
+      REAL(dp), INTENT(IN) :: actual, expected
+      CHARACTER(*), INTENT(IN) :: label
+      IF (ABS(actual - expected) > tol) THEN
+         PRINT '(A,1X,ES17.9,1X,ES17.9)', label, actual, expected
+         ERROR STOP "Spinor RCP kernel test failed"
+      END IF
+   END SUBROUTINE near
