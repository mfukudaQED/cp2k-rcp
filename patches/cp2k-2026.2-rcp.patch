+! RCP n_ew is an electron-number density; combine all collinear spin channels explicitly.
+
+      CALL timeset(routineN, handle)
+
+      logger => cp_get_default_logger()
+      unit_nr = cp_logger_get_default_io_unit(logger)
+      CALL get_qs_env(qs_env=qs_env, do_kpoints=do_kpoints, dft_control=dft_control)
+      ! A GAPW calculation uses ORB_SOFT plus atomic one-center corrections.
+      ! The GPW density collocator below cannot represent the all-electron RCP.
+      ! Fail before the default task-list lookup triggers a CPASSERT.
+      IF (dft_control%qs_control%gapw) THEN
+         CPABORT("RCP for GAPW (including ZORA/DKH) requires one-center density and kinetic corrections; not implemented")
+      END IF
+      IF (qs_env%rel_control%rel_method /= rel_none) THEN
+         CPABORT("RCP with an explicit relativistic kinetic operator is not implemented")
+      END IF
+      IF (do_kpoints) THEN
+         CALL get_qs_env(qs_env=qs_env, pw_env=pw_env, rho=rho, input=input, &
+                         nelectron_total=nelectron_total, nelectron_spin=nelectron_spin, &
+                         subsys=subsys, ks_env=ks_env, energy=energy, scf_control=scf_control, &
+                         kpoints=kpoints, matrix_s_kp=matrix_s_kp)
+         CALL qs_rho_get(rho_struct=rho, rho_ao_kp=rho_ao_kp)
+         nspins = SIZE(rho_ao_kp, 1)
+      ELSE
+         CALL get_qs_env(qs_env=qs_env, blacs_env=blacs_env, matrix_ks=matrix_ks, &
+                         pw_env=pw_env, rho=rho, input=input, nelectron_total=nelectron_total, &
+                         nelectron_spin=nelectron_spin, subsys=subsys, ks_env=ks_env, &
+                         matrix_s=matrix_s, energy=energy, scf_control=scf_control)
+         CALL qs_rho_get(rho_struct=rho, rho_ao=rho_ao)
+         nspins = SIZE(rho_ao)
+         IF (SIZE(matrix_ks) /= nspins) CPABORT("RCP inconsistent Gamma-point spin matrices")
+      END IF
+      CALL qs_subsys_get(subsys, particles=particles)
+      NULLIFY(window_kp, matrix_images)
+      IF (nspins < 1 .OR. nspins > 2) THEN
+         CPABORT("RCP analysis currently supports collinear RKS/UKS calculations only")
+      END IF
+      IF (nspins == 1 .AND. MOD(nelectron_total, 2) /= 0) THEN
+         CPABORT("RCP RKS analysis requires an even number of electrons")
+      END IF
+      CALL pw_env_get(pw_env, auxbas_pw_pool=auxbas_pw_pool)
+
+      dft_section => section_vals_get_subs_vals(input, "DFT")
+      ls_scf_section => section_vals_get_subs_vals(input, "DFT%LS_SCF")
+      CALL section_vals_val_get(dft_section, "PRINT%RCP%ENERGY_LOWER", r_val=energy_lower)
+      CALL section_vals_val_get(dft_section, "PRINT%RCP%ENERGY_UPPER", r_val=energy_upper)
+      CALL section_vals_val_get(dft_section, "PRINT%RCP%BROADENING_LOWER", r_val=broadening_lower)
+      CALL section_vals_val_get(dft_section, "PRINT%RCP%BROADENING_UPPER", r_val=broadening_upper)
+      CALL section_vals_val_get(dft_section, "PRINT%RCP%EPS_FILTER", r_val=filter_eps)
+      CALL section_vals_val_get(dft_section, "PRINT%RCP%DENSITY_CUTOFF", r_val=density_cutoff)
+      CALL section_vals_val_get(dft_section, "PRINT%RCP%PRINT_DENSITY_WINDOW", l_val=print_density_window)
+      CALL section_vals_val_get(dft_section, "PRINT%RCP%PRINT_KINETIC_ENERGY_DENSITY", &
+                                l_val=print_kinetic_energy_density)
+      CALL section_vals_val_get(dft_section, "PRINT%RCP%PRINT_REGIONAL_ENERGY_DENSITY", &
+                                l_val=print_regional_energy_density)
+      CALL section_vals_val_get(dft_section, "PRINT%RCP%PRINT_RCP", l_val=print_rcp)
+      CALL section_vals_val_get(dft_section, "PRINT%RCP%MPI_IO", l_val=rcp_mpi_io)
+      need_density = print_density_window .OR. print_rcp
+      need_regional = print_regional_energy_density .OR. print_rcp
+      need_kinetic = print_kinetic_energy_density
+      need_window = need_density .OR. need_regional
+      NULLIFY (stride)
+      ALLOCATE (stride(3))
+      stride = section_get_ivals(dft_section, "PRINT%RCP%STRIDE")
+      IF (need_window .AND. .NOT. do_kpoints) THEN
+         CALL section_vals_val_get(ls_scf_section, "EPS_LANCZOS", r_val=lanzcos_threshold)
+         CALL section_vals_val_get(ls_scf_section, "MAX_ITER_LANCZOS", i_val=lanzcos_max_iter)
+         CALL section_vals_val_get(ls_scf_section, "SIGN_SQRT_ORDER", i_val=newton_schulz_order)
+
+         IF (energy_lower >= energy_upper) THEN
+            CPABORT("RCP ENERGY_LOWER must be smaller than ENERGY_UPPER")
+         END IF
+         IF (broadening_lower <= 0.0_dp .OR. broadening_upper <= 0.0_dp) THEN
+            CPABORT("RCP broadenings must be positive")
+         END IF
+
+         CALL dbcsr_get_info(matrix=matrix_ks(1)%matrix, nfullrows_total=nao)
+         ALLOCATE (eigenvalues(nao, nspins), weights(nao), eigenvectors_spin(nspins), window_spin(nspins))
+         CALL dbcsr_create(tmp, template=matrix_s(1)%matrix, matrix_type="N")
+         CALL dbcsr_create(S_minus_half, template=matrix_s(1)%matrix, matrix_type="N")
+         CALL dbcsr_create(S_half, template=matrix_s(1)%matrix, matrix_type="N")
+         DO ispin = 1, nspins
+            CALL dbcsr_create(window_spin(ispin), template=matrix_ks(ispin)%matrix)
+         END DO
+         CALL cp_fm_struct_create(fmstruct=ao_ao_fmstruct, context=blacs_env, nrow_global=nao, ncol_global=nao)
+         CALL cp_fm_create(P_window_fm, ao_ao_fmstruct)
+         CALL cp_fm_create(matrix_ks_fm, ao_ao_fmstruct)
+         CALL cp_fm_create(S_minus_half_fm, ao_ao_fmstruct)
+         DO ispin = 1, nspins
+            CALL cp_fm_create(eigenvectors_spin(ispin), ao_ao_fmstruct)
+         END DO
+         CALL cp_fm_create(eigenvectors_nonorth, ao_ao_fmstruct)
+         CALL cp_fm_create(weighted_mos, ao_ao_fmstruct)
+         CALL cp_fm_create(overlap_fm, ao_ao_fmstruct)
+      END IF
+      IF (need_window .AND. do_kpoints) THEN
+         IF (energy_lower >= energy_upper) CPABORT("RCP ENERGY_LOWER must be smaller than ENERGY_UPPER")
+         IF (broadening_lower <= 0.0_dp .OR. broadening_upper <= 0.0_dp) THEN
+            CPABORT("RCP broadenings must be positive")
+         END IF
+      END IF
+      IF (print_rcp .AND. density_cutoff <= 0.0_dp) THEN
+         CPABORT("RCP DENSITY_CUTOFF must be positive")
+      END IF
+      IF (need_density) CALL auxbas_pw_pool%create_pw(rho_r)
+      IF (need_kinetic) CALL auxbas_pw_pool%create_pw(te_r)
+      IF (need_regional) THEN
+         CALL auxbas_pw_pool%create_pw(regional_energy_laplacian_r)
+         CALL auxbas_pw_pool%create_pw(regional_energy_grad_r)
+         CALL auxbas_pw_pool%create_pw(regional_energy_r)
+      END IF
+      IF (print_rcp) CALL auxbas_pw_pool%create_pw(rcp_r)
+      IF (need_density .OR. need_kinetic .OR. need_regional) THEN
+         CALL auxbas_pw_pool%create_pw(spin_component_r)
+         CALL auxbas_pw_pool%create_pw(spin_component_g)
+      END IF
+
+      IF (need_window .AND. .NOT. do_kpoints) THEN
+         CALL matrix_sqrt_Newton_Schulz(S_half, S_minus_half, matrix_s(1)%matrix, filter_eps, &
+                                        newton_schulz_order, lanzcos_threshold, lanzcos_max_iter)
+
+         global_homo = -HUGE(one)
+         global_lumo = HUGE(one)
+         DO ispin = 1, nspins
+            CALL dbcsr_desymmetrize(matrix_ks(ispin)%matrix, matrix_ks_nosym)
+            CALL dbcsr_multiply("N", "N", one, S_minus_half, matrix_ks_nosym, zero, tmp, filter_eps=filter_eps)
+            CALL dbcsr_multiply("N", "N", one, tmp, S_minus_half, zero, matrix_ks_nosym, filter_eps=filter_eps)
+            CALL copy_dbcsr_to_fm(matrix_ks_nosym, matrix_ks_fm)
+            CALL choose_eigv_solver(matrix_ks_fm, eigenvectors_spin(ispin), eigenvalues(:, ispin))
+            CALL dbcsr_release(matrix_ks_nosym)
+
+            IF (nspins == 1) THEN
+               nocc = nelectron_total/2
+            ELSE
+               nocc = nelectron_spin(ispin)
+            END IF
+            IF (nocc > 0) global_homo = MAX(global_homo, eigenvalues(nocc, ispin))
+            IF (nocc < nao) global_lumo = MIN(global_lumo, eigenvalues(nocc + 1, ispin))
+         END DO
+         IF (global_homo <= -HUGE(one)/2.0_dp .OR. global_lumo >= HUGE(one)/2.0_dp) THEN
+            CPABORT("RCP could not determine a global HOMO-LUMO chemical potential")
+         END IF
+         midpoint_level = 0.5_dp*(global_homo + global_lumo)
+         fermi_level = midpoint_level
+         IF (ASSOCIATED(scf_control%smear)) THEN
+            IF (scf_control%smear%do_smear) fermi_level = energy%efermi
+         END IF
+
+         CALL copy_dbcsr_to_fm(S_minus_half, S_minus_half_fm)
+         CALL copy_dbcsr_to_fm(matrix_s(1)%matrix, overlap_fm)
+         electron_count_weights = 0.0_dp
+         electron_count_matrix = 0.0_dp
+         DO ispin = 1, nspins
+            IF (nspins == 1) THEN
+               spin_factor = 2.0_dp
+            ELSE
+               spin_factor = 1.0_dp
+            END IF
+
+            CALL parallel_gemm("N", "N", nao, nao, nao, one, S_minus_half_fm, &
+                               eigenvectors_spin(ispin), zero, eigenvectors_nonorth)
+            DO i = 1, nao
+               f_upper = rcp_fermi_function(eigenvalues(i, ispin) - fermi_level, &
+                                            energy_upper, broadening_upper)
+               f_lower = rcp_fermi_function(eigenvalues(i, ispin) - fermi_level, &
+                                            energy_lower, broadening_lower)
+               weights(i) = MAX(0.0_dp, MIN(1.0_dp, f_upper - f_lower))
+            END DO
+            electron_count_weights = electron_count_weights + spin_factor*SUM(weights)
+
+            CALL cp_fm_to_fm(eigenvectors_nonorth, weighted_mos)
+            CALL cp_fm_get_info(weighted_mos, ncol_local=ncol_local, col_indices=col_indices)
+            DO j = 1, ncol_local
+               scale = SQRT(spin_factor*weights(col_indices(j)))
+               weighted_mos%local_data(:, j) = scale*weighted_mos%local_data(:, j)
+            END DO
+            CALL parallel_gemm("N", "T", nao, nao, nao, one, weighted_mos, weighted_mos, zero, P_window_fm)
+
+            CALL cp_fm_trace(P_window_fm, overlap_fm, electron_count_spin)
+            electron_count_matrix = electron_count_matrix + electron_count_spin
+
+            CALL copy_fm_to_dbcsr(P_window_fm, tmp)
+            CALL dbcsr_copy(window_spin(ispin), matrix_ks(ispin)%matrix)
+            CALL dbcsr_copy(window_spin(ispin), tmp, keep_sparsity=.TRUE.)
+         END DO
+      END IF
+      IF (need_window .AND. do_kpoints) THEN
+         CALL rcp_window_kpoints(kpoints, rho_ao_kp, matrix_s_kp, energy, scf_control, &
+                                 energy_lower, energy_upper, broadening_lower, broadening_upper, &
+                                 window_kp, electron_count_weights, electron_count_matrix, &
+                                 global_homo, global_lumo, midpoint_level, fermi_level)
+      END IF
+      IF (need_density) THEN
+         CALL pw_zero(rho_r)
+         DO ispin = 1, nspins
+            IF (do_kpoints) THEN
+               matrix_images => window_kp(ispin, :)
+               CALL calculate_rho_elec(matrix_p_kp=matrix_images, rho=spin_component_r, &
+                                       rho_gspace=spin_component_g, ks_env=ks_env)
+            ELSE
+               CALL calculate_rho_elec(matrix_p=window_spin(ispin), rho=spin_component_r, &
+                                       rho_gspace=spin_component_g, ks_env=ks_env)
+            END IF
+            CALL pw_axpy(spin_component_r, rho_r, alpha=one)
+         END DO
+         electron_count_grid = pw_integrate_function(rho_r)
+      END IF
+
+      IF (need_kinetic) THEN
+         ! Direct Laplacian-form kinetic energy density used by RCP:
+         ! T_e(r) = -1/4 sum_mn P_mn [phi_m Laplacian(phi_n) + Laplacian(phi_m) phi_n].
+         CALL pw_zero(te_r)
+         DO ispin = 1, nspins
+            IF (do_kpoints) THEN
+               matrix_images => rho_ao_kp(ispin, :)
+               CALL calculate_rho_elec(matrix_p_kp=matrix_images, rho=spin_component_r, &
+                                       rho_gspace=spin_component_g, ks_env=ks_env, soft_valid=.FALSE., &
+                                       compute_kinetic_laplacian=.TRUE.)
+            ELSE
+               CALL calculate_rho_elec(matrix_p=rho_ao(ispin)%matrix, rho=spin_component_r, &
+                                       rho_gspace=spin_component_g, ks_env=ks_env, soft_valid=.FALSE., &
+                                       compute_kinetic_laplacian=.TRUE.)
+            END IF
+            CALL pw_axpy(spin_component_r, te_r, alpha=one)
+         END DO
+         kinetic_energy_grid = pw_integrate_function(te_r)
+         kinetic_energy_reference = energy%kinetic
+      END IF
+
+      IF (need_regional) THEN
+         ! Regional energy density for the selected energy window:
+         ! epsilon_tau,ew(r) = 1/8 P_ew [phi_m Laplacian(phi_n) + Laplacian(phi_m) phi_n]
+         !                   - 1/4 P_ew grad(phi_m).grad(phi_n).
+         ! GRID_FUNC_KINETIC_LAPLACIAN evaluates -1/4 times the symmetric Laplacian term,
+         ! while compute_tau evaluates +1/2 times the gradient-dot-gradient term.
+         CALL pw_zero(regional_energy_laplacian_r)
+         DO ispin = 1, nspins
+            IF (do_kpoints) THEN
+               matrix_images => window_kp(ispin, :)
+               CALL calculate_rho_elec(matrix_p_kp=matrix_images, rho=spin_component_r, &
+                                       rho_gspace=spin_component_g, ks_env=ks_env, soft_valid=.FALSE., &
+                                       compute_kinetic_laplacian=.TRUE.)
+            ELSE
+               CALL calculate_rho_elec(matrix_p=window_spin(ispin), rho=spin_component_r, &
+                                       rho_gspace=spin_component_g, ks_env=ks_env, soft_valid=.FALSE., &
+                                       compute_kinetic_laplacian=.TRUE.)
+            END IF
+            CALL pw_axpy(spin_component_r, regional_energy_laplacian_r, alpha=one)
+         END DO
+         regional_energy_laplacian_integral = pw_integrate_function(regional_energy_laplacian_r)
+
+         CALL pw_zero(regional_energy_grad_r)
+         DO ispin = 1, nspins
+            IF (do_kpoints) THEN
+               matrix_images => window_kp(ispin, :)
+               CALL calculate_rho_elec(matrix_p_kp=matrix_images, rho=spin_component_r, &
+                                       rho_gspace=spin_component_g, ks_env=ks_env, soft_valid=.FALSE., &
+                                       compute_tau=.TRUE.)
+            ELSE
+               CALL calculate_rho_elec(matrix_p=window_spin(ispin), rho=spin_component_r, &
+                                       rho_gspace=spin_component_g, ks_env=ks_env, soft_valid=.FALSE., &
+                                       compute_tau=.TRUE.)
+            END IF
+            CALL pw_axpy(spin_component_r, regional_energy_grad_r, alpha=one)
+         END DO
+         regional_energy_grad_integral = pw_integrate_function(regional_energy_grad_r)
+
+         CALL pw_zero(regional_energy_r)
+         CALL pw_axpy(regional_energy_laplacian_r, regional_energy_r, alpha=-0.5_dp)
+         CALL pw_axpy(regional_energy_grad_r, regional_energy_r, alpha=-0.5_dp)
+         regional_energy_integral = pw_integrate_function(regional_energy_r)
+      END IF
+
+      IF (print_rcp) THEN
+         ! Regional chemical potential. Mask the low-density tail before division to
+         ! prevent numerical overflow and NaN/Inf values in vacuum regions.
+         CALL pw_zero(rcp_r)
+         bo = rho_r%pw_grid%bounds_local
+!$OMP PARALLEL DO DEFAULT(NONE) SHARED(bo, density_cutoff, rcp_r, regional_energy_r, rho_r) PRIVATE(i, j, k)
+         DO k = bo(1, 3), bo(2, 3)
+            DO j = bo(1, 2), bo(2, 2)
+               DO i = bo(1, 1), bo(2, 1)
+                  IF (rho_r%array(i, j, k) > density_cutoff) THEN
+                     rcp_r%array(i, j, k) = regional_energy_r%array(i, j, k)/rho_r%array(i, j, k)
+                  ELSE
+                     rcp_r%array(i, j, k) = 0.0_dp
+                  END IF
+               END DO
+            END DO
+         END DO
+      END IF
+
+      IF (unit_nr > 0) THEN
+         IF (need_window) THEN
+            WRITE (unit_nr, "(A,I20)") " RCP| Number of collinear spin channels:        ", nspins
+            WRITE (unit_nr, "(A,F20.12)") " RCP| Global HOMO [a.u.]:                       ", global_homo
+            WRITE (unit_nr, "(A,F20.12)") " RCP| Global LUMO [a.u.]:                       ", global_lumo
+            WRITE (unit_nr, "(A,F20.12)") " RCP| HOMO-LUMO midpoint [a.u.]:                 ", midpoint_level
+            WRITE (unit_nr, "(A,F20.12)") " RCP| Reference chemical potential [a.u.]:       ", fermi_level
+            WRITE (unit_nr, "(A,2F20.12)") " RCP| Relative energy window [a.u.]:            ", energy_lower, energy_upper
+            WRITE (unit_nr, "(A,2ES20.10)") " RCP| Lower/upper broadening [a.u.]:            ", &
+               broadening_lower, broadening_upper
+            WRITE (unit_nr, "(A,F20.12)") " RCP| Electron count from sum(weights):         ", electron_count_weights
+            WRITE (unit_nr, "(A,F20.12)") " RCP| Electron count from Tr[P_window*S]:       ", electron_count_matrix
+         END IF
+         IF (need_density) THEN
+            WRITE (unit_nr, "(A,F20.12)") " RCP| Electron count from grid integration:     ", electron_count_grid
+            WRITE (unit_nr, "(A,ES20.10)") " RCP| |Tr[P*S]-grid integral|:                  ", &
+               ABS(electron_count_matrix - electron_count_grid)
+         END IF
+         IF (need_kinetic) THEN
+            WRITE (unit_nr, "(A,F20.12)") " RCP| Integral of Laplacian-form T_e [a.u.]:     ", kinetic_energy_grid
+            WRITE (unit_nr, "(A,F20.12)") " RCP| CP2K kinetic energy [a.u.]:                ", kinetic_energy_reference
+            WRITE (unit_nr, "(A,ES20.10)") " RCP| |Integral(T_e)-E_kin| [a.u.]:              ", &
+               ABS(kinetic_energy_grid - kinetic_energy_reference)
+         END IF
+         IF (need_regional) THEN
+            WRITE (unit_nr, "(A,F20.12)") " RCP| Window Laplacian component integral [a.u.]: ", &
+               regional_energy_laplacian_integral
+            WRITE (unit_nr, "(A,F20.12)") " RCP| Window gradient component integral [a.u.]:  ", &
+               regional_energy_grad_integral
+            WRITE (unit_nr, "(A,F20.12)") " RCP| Regional energy density integral [a.u.]:    ", &
+               regional_energy_integral
+            WRITE (unit_nr, "(A,ES20.10)") " RCP| |Laplacian-gradient integrals| [a.u.]:      ", &
+               ABS(regional_energy_laplacian_integral - regional_energy_grad_integral)
+         END IF
+         IF (print_rcp) THEN
+            WRITE (unit_nr, "(A,ES20.10)") " RCP| Density cutoff for RCP ratio [a.u.]:         ", density_cutoff
+         END IF
+      END IF
+
+      IF (print_density_window) THEN
+         WRITE (ext, "(A,A,A)") "-RCP-DENSITY-WINDOW", TRIM(cp_iter_string(logger%iter_info)), ".cube"
+         mpi_io = rcp_mpi_io
+         print_unit = cp_print_key_unit_nr(logger, dft_section, "PRINT%RCP", &
+                                           extension=TRIM(ext), file_status="REPLACE", file_action="WRITE", &
+                                           log_filename=.FALSE., mpi_io=mpi_io)
+         CALL cp_pw_to_cube(rho_r, print_unit, "RCP ENERGY-WINDOW ELECTRON DENSITY", &
+                            particles=particles, stride=stride, mpi_io=mpi_io)
+         CALL cp_print_key_finished_output(print_unit, logger, dft_section, "PRINT%RCP", mpi_io=mpi_io)
+      END IF
+
+      IF (print_kinetic_energy_density) THEN
+         WRITE (ext, "(A,A,A)") "-RCP-KINETIC-ENERGY-DENSITY", TRIM(cp_iter_string(logger%iter_info)), ".cube"
+         mpi_io = rcp_mpi_io
+         print_unit = cp_print_key_unit_nr(logger, dft_section, "PRINT%RCP", &
+                                           extension=TRIM(ext), file_status="REPLACE", file_action="WRITE", &
+                                           log_filename=.FALSE., mpi_io=mpi_io)
+         CALL cp_pw_to_cube(te_r, print_unit, "RCP LAPLACIAN-FORM KINETIC ENERGY DENSITY", &
+                            particles=particles, stride=stride, mpi_io=mpi_io)
+         CALL cp_print_key_finished_output(print_unit, logger, dft_section, "PRINT%RCP", mpi_io=mpi_io)
+      END IF
+
+      IF (print_regional_energy_density) THEN
+         WRITE (ext, "(A,A,A)") "-RCP-REGIONAL-ENERGY-DENSITY", TRIM(cp_iter_string(logger%iter_info)), ".cube"
+         mpi_io = rcp_mpi_io
+         print_unit = cp_print_key_unit_nr(logger, dft_section, "PRINT%RCP", &
+                                           extension=TRIM(ext), file_status="REPLACE", file_action="WRITE", &
+                                           log_filename=.FALSE., mpi_io=mpi_io)
+         CALL cp_pw_to_cube(regional_energy_r, print_unit, "RCP ENERGY-WINDOW REGIONAL ENERGY DENSITY", &
+                            particles=particles, stride=stride, mpi_io=mpi_io)
+         CALL cp_print_key_finished_output(print_unit, logger, dft_section, "PRINT%RCP", mpi_io=mpi_io)
+      END IF
+
+      IF (print_rcp) THEN
+         WRITE (ext, "(A,A,A)") "-RCP", TRIM(cp_iter_string(logger%iter_info)), ".cube"
+         mpi_io = rcp_mpi_io
+         print_unit = cp_print_key_unit_nr(logger, dft_section, "PRINT%RCP", &
+                                           extension=TRIM(ext), file_status="REPLACE", file_action="WRITE", &
+                                           log_filename=.FALSE., mpi_io=mpi_io)
+         CALL cp_pw_to_cube(rcp_r, print_unit, "RCP REGIONAL CHEMICAL POTENTIAL [HARTREE]", &
+                            particles=particles, stride=stride, mpi_io=mpi_io)
+         CALL cp_print_key_finished_output(print_unit, logger, dft_section, "PRINT%RCP", mpi_io=mpi_io)
+      END IF
+
+      IF (need_window .AND. do_kpoints) CALL dbcsr_deallocate_matrix_set(window_kp)
+      IF (need_window .AND. .NOT. do_kpoints) THEN
+         CALL dbcsr_release(tmp)
+         DO ispin = 1, nspins
+            CALL dbcsr_release(window_spin(ispin))
+         END DO
+         DEALLOCATE (window_spin)
+         CALL dbcsr_release(S_minus_half)
+         CALL dbcsr_release(S_half)
+         CALL cp_fm_struct_release(ao_ao_fmstruct)
+         CALL cp_fm_release(matrix_ks_fm)
+         DO ispin = 1, nspins
+            CALL cp_fm_release(eigenvectors_spin(ispin))
+         END DO
+         DEALLOCATE (eigenvectors_spin)
+         CALL cp_fm_release(P_window_fm)
+         CALL cp_fm_release(eigenvectors_nonorth)
+         CALL cp_fm_release(S_minus_half_fm)
+         CALL cp_fm_release(weighted_mos)
+         CALL cp_fm_release(overlap_fm)
+         DEALLOCATE (eigenvalues, weights)
+      END IF
+      IF (need_density) CALL auxbas_pw_pool%give_back_pw(rho_r)
+      IF (need_kinetic) CALL auxbas_pw_pool%give_back_pw(te_r)
+      IF (need_regional) THEN
+         CALL auxbas_pw_pool%give_back_pw(regional_energy_laplacian_r)
+         CALL auxbas_pw_pool%give_back_pw(regional_energy_grad_r)
+         CALL auxbas_pw_pool%give_back_pw(regional_energy_r)
+      END IF
+      IF (print_rcp) CALL auxbas_pw_pool%give_back_pw(rcp_r)
+      IF (need_density .OR. need_kinetic .OR. need_regional) THEN
+         CALL auxbas_pw_pool%give_back_pw(spin_component_r)
+         CALL auxbas_pw_pool%give_back_pw(spin_component_g)
+      END IF
+      DEALLOCATE (stride)
+
+      CALL timestop(handle)
+
+   END SUBROUTINE rcp_energy_window
+
+! **************************************************************************************************
+!> \brief Numerically stable Fermi function used to construct the RCP energy window.
+!> \param energy Energy relative to the Fermi level.
+!> \param chemical_potential Window edge.
+!> \param width Fermi broadening.
+!> \return Fermi occupation factor.
+! **************************************************************************************************
+! **************************************************************************************************
+!> \brief Build the RCP window density using CP2K's Bloch-MO and k-to-real-space machinery.
+!> \note The MO occupations and k-point density matrices are restored before return.
+! **************************************************************************************************
+   SUBROUTINE rcp_window_kpoints(kpoints, rho_ao_kp, matrix_s_kp, energy, scf_control, &
+                                  energy_lower, energy_upper, broadening_lower, broadening_upper, &
+                                  window_kp, electron_count_weights, electron_count_matrix, &
+                                  global_homo, global_lumo, midpoint_level, fermi_level)
+      TYPE(kpoint_type), POINTER                         :: kpoints
+      TYPE(dbcsr_p_type), DIMENSION(:, :), POINTER       :: rho_ao_kp, matrix_s_kp, window_kp
+      TYPE(qs_energy_type), POINTER                      :: energy
+      TYPE(scf_control_type), POINTER                    :: scf_control
+      REAL(KIND=dp), INTENT(IN)                          :: energy_lower, energy_upper, &
+                                                            broadening_lower, broadening_upper
+      REAL(KIND=dp), INTENT(OUT)                         :: electron_count_weights, electron_count_matrix, &
+                                                            global_homo, global_lumo, midpoint_level, fermi_level
+
+      INTEGER                                            :: ik, iklocal, img, ispin, nimg, nlocal, &
+                                                            nmo, nao, nspins, nc, i
+      INTEGER, DIMENSION(2)                              :: kp_range
+      REAL(KIND=dp)                                      :: spin_factor, count_spin, f_upper, f_lower, &
+                                                            eig, tol
+      REAL(KIND=dp), ALLOCATABLE, DIMENSION(:, :, :)     :: saved_occupations
+      REAL(KIND=dp), DIMENSION(:), POINTER               :: eigenvalues, occupations
+      REAL(KIND=dp), DIMENSION(:), POINTER               :: wkp
+      TYPE(cp_fm_struct_type), POINTER                   :: fmstruct
+      TYPE(cp_fm_type), ALLOCATABLE, DIMENSION(:)        :: fmwork
+      TYPE(dbcsr_type), POINTER                          :: matrix_template
+      TYPE(kpoint_env_type), POINTER                     :: kp
+      TYPE(mo_set_type), POINTER                         :: mo_set
+      TYPE(neighbor_list_set_p_type), DIMENSION(:), POINTER :: sab_nl
+
+      CALL get_kpoint_info(kpoints, kp_range=kp_range, wkp=wkp, sab_nl=sab_nl)
+      nlocal = kp_range(2) - kp_range(1) + 1
+      IF (nlocal < 1) CPABORT("RCP k-point group contains no local k-points")
+      kp => kpoints%kp_env(1)%kpoint_env
+      nspins = SIZE(kp%mos, 2)
+      nc = SIZE(kp%mos, 1)
+      IF (nc < 1 .OR. nc > 2) CPABORT("RCP supports real/complex collinear k-point orbitals only")
+      CALL get_mo_set(kp%mos(1, 1), nmo=nmo, nao=nao)
+      nimg = SIZE(rho_ao_kp, 2)
+      ALLOCATE(saved_occupations(nmo, nlocal, nspins))
+      global_homo = -HUGE(1.0_dp)
+      global_lumo = HUGE(1.0_dp)
+      tol = 1.0E-7_dp
+
+      ! First determine the common gap edges before changing any occupations.
+      DO iklocal = 1, nlocal
+         kp => kpoints%kp_env(iklocal)%kpoint_env
+         DO ispin = 1, nspins
+            mo_set => kp%mos(1, ispin)
+            CALL get_mo_set(mo_set, eigenvalues=eigenvalues, occupation_numbers=occupations)
+            saved_occupations(:, iklocal, ispin) = occupations(1:nmo)
+            DO i = 1, nmo
+               eig = eigenvalues(i)
+               IF (occupations(i) >= mo_set%maxocc*(0.5_dp + tol)) THEN
+                  global_homo = MAX(global_homo, eig)
+               ELSE
+                  global_lumo = MIN(global_lumo, eig)
+               END IF
+            END DO
+         END DO
+      END DO
+      CALL kpoints%para_env_inter_kp%max(global_homo)
+      CALL kpoints%para_env_inter_kp%min(global_lumo)
+      IF (global_homo <= -HUGE(1.0_dp)/2.0_dp .OR. global_lumo >= HUGE(1.0_dp)/2.0_dp) THEN
+         CPABORT("RCP k-point calculation needs occupied and unoccupied bands")
+      END IF
+      midpoint_level = 0.5_dp*(global_homo + global_lumo)
+      fermi_level = midpoint_level
+      IF (ASSOCIATED(scf_control%smear)) THEN
+         IF (scf_control%smear%do_smear) fermi_level = energy%efermi
+      END IF
+
+      electron_count_weights = 0.0_dp
+      ! Temporarily substitute energy-window occupations; the native density-matrix
+      ! construction takes care of real and imaginary Bloch coefficients.
+      DO iklocal = 1, nlocal
+         ik = kp_range(1) + iklocal - 1
+         kp => kpoints%kp_env(iklocal)%kpoint_env
+         DO ispin = 1, nspins
+            mo_set => kp%mos(1, ispin)
+            spin_factor = mo_set%maxocc
+            CALL get_mo_set(mo_set, eigenvalues=eigenvalues, occupation_numbers=occupations)
+            DO i = 1, nmo
+               f_upper = rcp_fermi_function(eigenvalues(i) - fermi_level, &
+                                            energy_upper, broadening_upper)
+               f_lower = rcp_fermi_function(eigenvalues(i) - fermi_level, &
+                                            energy_lower, broadening_lower)
+               occupations(i) = spin_factor*MAX(0.0_dp, MIN(1.0_dp, f_upper - f_lower))
+            END DO
+            electron_count_weights = electron_count_weights + wkp(ik)*SUM(occupations(1:nmo))
+         END DO
+      END DO
+      CALL kpoints%para_env_inter_kp%sum(electron_count_weights)
+
+      CALL dbcsr_allocate_matrix_set(window_kp, nspins, nimg)
+      DO ispin = 1, nspins
+         DO img = 1, nimg
+            ALLOCATE(window_kp(ispin, img)%matrix)
+            CALL dbcsr_copy(window_kp(ispin, img)%matrix, rho_ao_kp(ispin, img)%matrix)
+         END DO
+      END DO
+
+      CALL cp_fm_struct_create(fmstruct, context=kpoints%blacs_env_all, &
+                               nrow_global=nao, ncol_global=nao, para_env=kpoints%para_env)
+      ALLOCATE(fmwork(nc))
+      DO i = 1, nc
+         CALL cp_fm_create(fmwork(i), fmstruct)
+      END DO
+      CALL cp_fm_struct_release(fmstruct)
+
+      CALL kpoint_density_matrices(kpoints)
+      matrix_template => matrix_s_kp(1, 1)%matrix
+      CALL kpoint_density_transform(kpoints, window_kp, .FALSE., matrix_template, sab_nl, fmwork, &
+                                    overlap_rs=matrix_s_kp)
+
+      ! Restore both occupations and the ordinary density matrices immediately.
+      DO iklocal = 1, nlocal
+         kp => kpoints%kp_env(iklocal)%kpoint_env
+         DO ispin = 1, nspins
+            mo_set => kp%mos(1, ispin)
+            CALL get_mo_set(mo_set, occupation_numbers=occupations)
+            occupations(1:nmo) = saved_occupations(:, iklocal, ispin)
+         END DO
+      END DO
+      CALL kpoint_density_matrices(kpoints)
+
+      electron_count_matrix = 0.0_dp
+      DO ispin = 1, nspins
+         DO img = 1, nimg
+            CALL dbcsr_dot(window_kp(ispin, img)%matrix, matrix_s_kp(1, img)%matrix, count_spin)
+            electron_count_matrix = electron_count_matrix + count_spin
+         END DO
+      END DO
+      DO i = 1, nc
+         CALL cp_fm_release(fmwork(i))
+      END DO
+      DEALLOCATE(fmwork, saved_occupations)
+   END SUBROUTINE rcp_window_kpoints
+
+   PURE FUNCTION rcp_fermi_function(energy, chemical_potential, width) RESULT(value)
+      REAL(KIND=dp), INTENT(IN)                          :: energy, chemical_potential, width
+      REAL(KIND=dp)                                      :: value
+
+      REAL(KIND=dp)                                      :: x
+
+      x = (energy - chemical_potential)/width
+      IF (x > 50.0_dp) THEN
+         value = 0.0_dp
+      ELSE IF (x < -50.0_dp) THEN
+         value = 1.0_dp
+      ELSE
+         value = 1.0_dp/(1.0_dp + EXP(x))
+      END IF
+
+   END FUNCTION rcp_fermi_function
+
 !**************************************************************************************************
 
 END MODULE qs_energy_window
