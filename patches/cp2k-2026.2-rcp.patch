+++ b/src/rcp_spinor.F
@@ -0,0 +1,63 @@
+!--------------------------------------------------------------------------------------------------!
+!   CP2K: A general program to perform molecular dynamics simulations
+!   Copyright 2000-2026 CP2K developers group <https://cp2k.org>
+!
+!   SPDX-License-Identifier: GPL-2.0-or-later
+!--------------------------------------------------------------------------------------------------!
+
+!> \brief Spinor-resolved local RCP density and kinetic-energy kernels.
+!> \note This module acts on two-component Pauli spinors already evaluated
+!>       at a grid point. It does not perform SCF or spinor AO collocation.
+MODULE rcp_spinor
+   USE, INTRINSIC :: iso_fortran_env, ONLY: real64
+   IMPLICIT NONE
+   PRIVATE
+   INTEGER, PARAMETER :: dp = real64
+   PUBLIC :: rcp_spinor_local
+CONTAINS
+! **************************************************************************************************
+!> \brief Evaluate charge/spin and regional energy from two-component spinors.
+!> \param psi Two spinor components for each state, shape (2, nstates).
+!> \param grad Cartesian gradients of the spinor, shape (2, 3, nstates).
+!> \param lap Spatial Laplacian of each spinor, shape (2, nstates).
+!> \param weights Nonnegative energy-window occupations including k-point weights.
+!> \param density Spin trace of the energy-window density matrix.
+!> \param magnetization Pauli-vector components (Mx, My, Mz) in electron-density units.
+!> \param t_lap Symmetric Laplacian kinetic-energy density, -Re[psi^+ lap psi]/2.
+!> \param t_grad Positive gradient kinetic-energy density, sum |grad psi|^2/2.
+!> \param regional_energy The nonrelativistic RCP regional-energy numerator,
+!>       -0.5*(t_lap + t_grad), summed over spinor components.
+!> \note The operator contains no relativistic kinetic correction. Spin-orbit
+!>       effects enter through the input spinors, not through a local SOC term.
+! **************************************************************************************************
+   PURE SUBROUTINE rcp_spinor_local(psi, grad, lap, weights, density, magnetization, &
+                                    t_lap, t_grad, regional_energy)
+      COMPLEX(dp), INTENT(IN)                          :: psi(:, :), grad(:, :, :), lap(:, :)
+      REAL(dp), INTENT(IN)                             :: weights(:)
+      REAL(dp), INTENT(OUT)                            :: density, magnetization(3), &
+                                                          t_lap, t_grad, regional_energy
+
+      INTEGER                                          :: n, j
+      REAL(dp)                                         :: w
+      COMPLEX(dp)                                      :: ud
+
+      density = 0.0_dp
+      magnetization = 0.0_dp
+      t_lap = 0.0_dp
+      t_grad = 0.0_dp
+      DO n = 1, SIZE(weights)
+         w = weights(n)
+         density = density + w*(ABS(psi(1, n))**2 + ABS(psi(2, n))**2)
+         ud = CONJG(psi(1, n))*psi(2, n)
+         magnetization(1) = magnetization(1) + 2.0_dp*w*REAL(ud, dp)
+         magnetization(2) = magnetization(2) + 2.0_dp*w*AIMAG(ud)
+         magnetization(3) = magnetization(3) + w*(ABS(psi(1, n))**2 - ABS(psi(2, n))**2)
+         t_lap = t_lap - 0.5_dp*w*REAL( &
+            CONJG(psi(1, n))*lap(1, n) + CONJG(psi(2, n))*lap(2, n), dp)
+         DO j = 1, 3
+            t_grad = t_grad + 0.5_dp*w*(ABS(grad(1, j, n))**2 + ABS(grad(2, j, n))**2)
+         END DO
+      END DO
+      regional_energy = -0.5_dp*(t_lap + t_grad)
+   END SUBROUTINE rcp_spinor_local
+END MODULE rcp_spinor
