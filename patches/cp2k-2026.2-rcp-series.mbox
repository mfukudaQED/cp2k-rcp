 // *****************************************************************************
+// *****************************************************************************
+static void
+grid_prepare_pab_kinetic_laplacian(struct pab_computation_struct_ *const tp) {
+  // Mapping pab_prep with pgf_a * pgf_b is equivalent to
+  // -1/4 * [pgf_a * Laplacian(pgf_b) + Laplacian(pgf_a) * pgf_b].
+
+  for (int lxa = 0; lxa <= tp->lmax[0]; lxa++) {
+    for (int lxb = 0; lxb <= tp->lmax[1]; lxb++) {
+      for (int lya = 0; lya <= tp->lmax[0] - lxa; lya++) {
+        for (int lyb = 0; lyb <= tp->lmax[1] - lxb; lyb++) {
+          for (int lza = imax(tp->lmin[0] - lxa - lya, 0);
+               lza <= tp->lmax[0] - lxa - lya; lza++) {
+            for (int lzb = imax(tp->lmin[1] - lxb - lyb, 0);
+                 lzb <= tp->lmax[1] - lxb - lyb; lzb++) {
+              const int ico = tp->offset[0] + coset(lxa, lya, lza);
+              const int jco = tp->offset[1] + coset(lxb, lyb, lzb);
+              const double pab = idx2(tp->pab[0], jco, ico);
+
+              // x contribution
+              idx2(tp->pab_prep[0], coset(lxb, lyb, lzb),
+                   coset(imax(lxa - 2, 0), lya, lza)) +=
+                  -0.25 * lxa * (lxa - 1) * pab;
+              idx2(tp->pab_prep[0], coset(imax(lxb - 2, 0), lyb, lzb),
+                   coset(lxa, lya, lza)) += -0.25 * lxb * (lxb - 1) * pab;
+              idx2(tp->pab_prep[0], coset(lxb, lyb, lzb),
+                   coset(lxa, lya, lza)) +=
+                  0.5 *
+                  (tp->zeta[0] * (2 * lxa + 1) + tp->zeta[1] * (2 * lxb + 1)) *
+                  pab;
+              idx2(tp->pab_prep[0], coset(lxb, lyb, lzb),
+                   coset(lxa + 2, lya, lza)) -= tp->zeta[0] * tp->zeta[0] * pab;
+              idx2(tp->pab_prep[0], coset(lxb + 2, lyb, lzb),
+                   coset(lxa, lya, lza)) -= tp->zeta[1] * tp->zeta[1] * pab;
+
+              // y contribution
+              idx2(tp->pab_prep[0], coset(lxb, lyb, lzb),
+                   coset(lxa, imax(lya - 2, 0), lza)) +=
+                  -0.25 * lya * (lya - 1) * pab;
+              idx2(tp->pab_prep[0], coset(lxb, imax(lyb - 2, 0), lzb),
+                   coset(lxa, lya, lza)) += -0.25 * lyb * (lyb - 1) * pab;
+              idx2(tp->pab_prep[0], coset(lxb, lyb, lzb),
+                   coset(lxa, lya, lza)) +=
+                  0.5 *
+                  (tp->zeta[0] * (2 * lya + 1) + tp->zeta[1] * (2 * lyb + 1)) *
+                  pab;
+              idx2(tp->pab_prep[0], coset(lxb, lyb, lzb),
+                   coset(lxa, lya + 2, lza)) -= tp->zeta[0] * tp->zeta[0] * pab;
+              idx2(tp->pab_prep[0], coset(lxb, lyb + 2, lzb),
+                   coset(lxa, lya, lza)) -= tp->zeta[1] * tp->zeta[1] * pab;
+
+              // z contribution
+              idx2(tp->pab_prep[0], coset(lxb, lyb, lzb),
+                   coset(lxa, lya, imax(lza - 2, 0))) +=
+                  -0.25 * lza * (lza - 1) * pab;
+              idx2(tp->pab_prep[0], coset(lxb, lyb, imax(lzb - 2, 0)),
+                   coset(lxa, lya, lza)) += -0.25 * lzb * (lzb - 1) * pab;
+              idx2(tp->pab_prep[0], coset(lxb, lyb, lzb),
+                   coset(lxa, lya, lza)) +=
+                  0.5 *
+                  (tp->zeta[0] * (2 * lza + 1) + tp->zeta[1] * (2 * lzb + 1)) *
+                  pab;
+              idx2(tp->pab_prep[0], coset(lxb, lyb, lzb),
+                   coset(lxa, lya, lza + 2)) -= tp->zeta[0] * tp->zeta[0] * pab;
+              idx2(tp->pab_prep[0], coset(lxb, lyb, lzb + 2),
+                   coset(lxa, lya, lza)) -= tp->zeta[1] * tp->zeta[1] * pab;
+            }
+          }
+        }
+      }
+    }
+  }
+}
