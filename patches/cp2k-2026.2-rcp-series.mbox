+/*******************************************************************************
+ * \brief Symmetric Laplacian-form kinetic-energy-density transformation.
+ ******************************************************************************/
+template <typename T>
+__device__ __inline__ void
+prepare_pab_kinetic_laplacian(const orbital a, const orbital b, const T zeta,
+                              const T zetb, const T pab_val, const int n,
+                              T *cab) {
+  for (int idir = 0; idir < 3; idir++) {
+    prep_term<T>(down(idir, down(idir, a)), b,
+                 -0.25 * a.l[idir] * (a.l[idir] - 1) * pab_val, n, cab);
+    prep_term<T>(a, down(idir, down(idir, b)),
+                 -0.25 * b.l[idir] * (b.l[idir] - 1) * pab_val, n, cab);
+    prep_term<T>(a, b,
+                 0.5 *
+                     (zeta * (2 * a.l[idir] + 1) + zetb * (2 * b.l[idir] + 1)) *
+                     pab_val,
+                 n, cab);
+    prep_term<T>(up(idir, up(idir, a)), b, -zeta * zeta * pab_val, n, cab);
+    prep_term<T>(a, up(idir, up(idir, b)), -zetb * zetb * pab_val, n, cab);
+  }
+}
