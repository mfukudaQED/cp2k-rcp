+/*******************************************************************************
+ * \brief Symmetric Laplacian-form kinetic-energy-density transformation.
+ *
+ * Mapping the prepared matrix with pgf_a * pgf_b is equivalent to
+ * -1/4 * [pgf_a * Laplacian(pgf_b) + Laplacian(pgf_a) * pgf_b].
+ ******************************************************************************/
+GRID_DEVICE static void
+prepare_pab_kinetic_laplacian(const orbital a, const orbital b,
+                              const double zeta, const double zetb,
+                              const double pab_val, cab_store *cab) {
+  for (int idir = 0; idir < 3; idir++) {
+    cab_add(cab, down(idir, down(idir, a)), b,
+            -0.25 * a.l[idir] * (a.l[idir] - 1) * pab_val);
+    cab_add(cab, a, down(idir, down(idir, b)),
+            -0.25 * b.l[idir] * (b.l[idir] - 1) * pab_val);
+    cab_add(cab, a, b,
+            0.5 * (zeta * (2 * a.l[idir] + 1) + zetb * (2 * b.l[idir] + 1)) *
+                pab_val);
+    cab_add(cab, up(idir, up(idir, a)), b, -zeta * zeta * pab_val);
+    cab_add(cab, a, up(idir, up(idir, b)), -zetb * zetb * pab_val);
+  }
+}
