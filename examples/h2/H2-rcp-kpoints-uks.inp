&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT H2-rcp-kpoints-uks
  RUN_TYPE ENERGY
  &GRID
    BACKEND REFERENCE
  &END GRID
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &KPOINTS
      SCHEME MONKHORST-PACK 2 1 1
      FULL_GRID ON
      SYMMETRY OFF
      WAVEFUNCTIONS COMPLEX
    &END KPOINTS
    &MGRID
      CUTOFF 300
      REL_CUTOFF 40
    &END MGRID
    &PRINT
      &RCP ON
        BROADENING_LOWER [eV] 0.001
        BROADENING_UPPER [eV] 0.001
        DENSITY_CUTOFF 1.0E-8
        ENERGY_LOWER [eV] -20.0
        ENERGY_UPPER [eV] 1.0
        PRINT_DENSITY_WINDOW F
        PRINT_KINETIC_ENERGY_DENSITY T
        PRINT_RCP T
        PRINT_REGIONAL_ENERGY_DENSITY T
        STRIDE 4 4 4
      &END RCP
    &END PRINT
    UKS TRUE
    MULTIPLICITY 1
    &SCF
      ADDED_MOS 4
      EPS_SCF 1.0E-8
      MAX_SCF 50
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 10.0 10.0 10.0
      PERIODIC XYZ
    &END CELL
    &COORD
      H 0.0 0.0 -0.3707
      H 0.0 0.0  0.3707
    &END COORD
    &KIND H
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
    &TOPOLOGY
      &CENTER_COORDINATES
      &END CENTER_COORDINATES
    &END TOPOLOGY
  &END SUBSYS
&END FORCE_EVAL
