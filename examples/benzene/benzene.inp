&GLOBAL
  PROJECT benzene_openmx_rcp
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 220
      REL_CUTOFF 40
    &END MGRID
    &POISSON
      PERIODIC NONE
      PSOLVER WAVELET
    &END POISSON
    &SCF
      EPS_SCF 1.0E-7
      MAX_SCF 100
      SCF_GUESS ATOMIC
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE
      &END OT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &PRINT
      &RCP ON
        ENERGY_LOWER [eV] -3.0
        ENERGY_UPPER [eV] 0.0
        BROADENING_LOWER [eV] 0.001
        BROADENING_UPPER [eV] 0.001
        DENSITY_CUTOFF 1.0E-12
        PRINT_DENSITY_WINDOW T
        PRINT_KINETIC_ENERGY_DENSITY T
        PRINT_REGIONAL_ENERGY_DENSITY T
        PRINT_RCP T
        STRIDE 1 1 1
      &END RCP
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      ABC 18.0 18.0 18.0
      PERIODIC NONE
    &END CELL
    &COORD
      C      8.988403909550     8.300550500266     9.000040103561
      C      8.988393369158     9.699467335219     8.999894099255
      C      7.776787407347     7.600849995795     8.999862361624
      C      7.776765974761    10.399151376162     9.000117145267
      C      6.565281551673     8.300361314856     9.000020414576
      C      6.565271968388     9.699620448493     8.999915104622
      H      7.776463688957     6.509309635119     8.999923596478
      H      7.776419601819    11.490691940426     9.000059855691
      H      9.933852493074     7.755294044538     8.999931224690
      H      9.933835755188    10.244733816559     9.000003446593
      H      5.620773258997     7.753708634543     8.999902898557
      H      5.620756574582    10.246260683641     9.000014771113
    &END COORD
    &KIND H
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND C
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
