&GLOBAL
  PROJECT c2h5_openmx_rcp
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    UKS T
    MULTIPLICITY 2
    &MGRID
      CUTOFF 220
      REL_CUTOFF 40
    &END MGRID
    &POISSON
      PERIODIC NONE
      PSOLVER WAVELET
    &END POISSON
    &SCF
      EPS_SCF 1.0E-7
      MAX_SCF 100
      SCF_GUESS ATOMIC
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE
      &END OT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &PRINT
      &RCP ON
        ENERGY_LOWER [eV] -2.0
        ENERGY_UPPER [eV] 0.0
        BROADENING_LOWER [eV] 0.001
        BROADENING_UPPER [eV] 0.001
        DENSITY_CUTOFF 1.0E-12
        PRINT_DENSITY_WINDOW T
        PRINT_KINETIC_ENERGY_DENSITY T
        PRINT_REGIONAL_ENERGY_DENSITY T
        PRINT_RCP T
        STRIDE 1 1 1
      &END RCP
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      ABC 20.0 15.0 15.0
      PERIODIC NONE
    &END CELL
    &COORD
      C      9.241783703196     7.499999987551     7.577671959362
      C     10.758154285388     7.500000010437     7.422329499452
      H     11.106860260068     6.614807342398     6.872753525653
      H     11.106860260445     8.385192755334     6.872753683544
      H      8.893073867948     6.614806938862     8.127245382129
      H      8.893073884003     8.385193034946     8.127245432256
      H     11.263436450860     7.499999938322     8.397844055653
    &END COORD
    &KIND H
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND C
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
